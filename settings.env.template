# GMC report - standalone runner settings. Copy this file to settings.env in the same folder.
# One setting per line: NAME=value. No quotes. Lines starting with # are notes.
# INSTRUCTIONS.md says which line to change; the Python files never need editing.

# --- Must fill in ---------------------------------------------------------------------
# The parent Merchant Center account ID (numbers only): the account all the stores sit under.
PARENT_MCA_ID=

# The OneDrive folder the report is saved into; its own Power Automate flow emails it.
# Only this PC may save into it: if another computer's flow emails from it too, two emails a day.
# Example: C:\Users\you\OneDrive - Company\GMC Reports - Server
REPORT_DROP_DIR=

# --- Retries (leave as they are unless you have a reason) ------------------------------
# If Google fails: how many tries in one run, and how many minutes between them.
FETCH_TRIES=3
FETCH_RETRY_MINUTES=30
# If saving the Excel file fails: tries and minutes between them. No new Google calls.
SAVE_TRIES=3
SAVE_RETRY_MINUTES=5

# --- Optional: only if you keep these somewhere else ----------------------------------
# Empty = the folder next to run_report.py (secrets\sa-key.json, data\..., app\...).
GCP_SA_KEY_PATH=
DB_PATH=
LOG_DIR=
STORE_DIRECTORY_PATH=
